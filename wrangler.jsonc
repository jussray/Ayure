{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ayure",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  // Production D1. Created 2026-10-01 (ENAM); 0001_create_ayure_leads.sql applied.
  // The binding name must be AYURE_DB (lib/db/cloudflare-d1.ts reads env.AYURE_DB).
  "d1_databases": [
    {
      "binding": "AYURE_DB",
      "database_name": "ayure-prod",
      "database_id": "28b66274-52e5-4d66-92e9-e8b69dde7da2",
      "migrations_dir": "migrations"
    }
  ]
  ,
  // Worker Previews must never bind the production AYURE_DB.
  "previews": {
    "d1_databases": [
      {
        "binding": "AYURE_DB",
        "database_name": "ayure-preview",
        "database_id": "25b48f0c-9704-43eb-b33c-90f83e6b3a58"
      }
    ]
  }
}
