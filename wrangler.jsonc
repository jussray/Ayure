{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ayure",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  // After `npm run cf:d1:create`, Wrangler adds the production D1 binding.
  // The binding name must be AYURE_DB and the database name must be ayure-prod.
  "d1_databases": []
}
